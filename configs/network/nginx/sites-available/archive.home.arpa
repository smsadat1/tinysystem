server {
    listen 80;
    listen [::]:80;

    server_name archive.home.arpa;

    root /srv/archive;
    index index.html;

    server_tokens off;

    location / {
        try_files $uri $uri/ =404;
        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
    }

    location ~ /\. {
        deny all;
    }
}
